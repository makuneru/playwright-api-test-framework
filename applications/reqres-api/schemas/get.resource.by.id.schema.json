{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Get Resource By ID Response",
  "description": "JSON Schema for Get Resource By ID API response - GET /api/{resource}/{id}",
  "type": "object",
  "properties": {
    "data": {
      "type": "object",
      "description": "Resource object",
      "properties": {
        "id": {
          "type": "number",
          "description": "Resource ID"
        },
        "name": {
          "type": "string",
          "description": "Resource name"
        },
        "year": {
          "type": "number",
          "description": "Resource year"
        },
        "color": {
          "type": "string",
          "description": "Resource color code"
        },
        "pantone_value": {
          "type": "string",
          "description": "Pantone color value"
        }
      },
      "required": ["id", "name", "year", "color", "pantone_value"]
    },
    "support": {
      "type": "object",
      "properties": {
        "url": {
          "type": "string",
          "format": "uri"
        },
        "text": {
          "type": "string"
        }
      },
      "required": ["url", "text"]
    },
    "_meta": {
      "type": "object",
      "description": "Metadata about the API",
      "properties": {
        "powered_by": {
          "type": "string"
        },
        "upgrade_url": {
          "type": "string",
          "format": "uri"
        },
        "docs_url": {
          "type": "string",
          "format": "uri"
        },
        "template_gallery": {
          "type": "string",
          "format": "uri"
        },
        "message": {
          "type": "string"
        },
        "features": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "upgrade_cta": {
          "type": "string"
        }
      },
      "required": ["powered_by", "upgrade_url", "docs_url", "template_gallery", "message", "features", "upgrade_cta"]
    }
  },
  "required": ["data", "support"]
}

